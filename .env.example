# =========================================================================
# Global Security Intelligence Desk — Environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# All values below are PLACEHOLDERS only.
# =========================================================================

# ---- Core application ----------------------------------------------------
# Flask secret key used for session signing. Generate a long random value.
GSID_SECRET_KEY=change-me-to-a-long-random-string

# Bind host/port for the development server.
GSID_HOST=127.0.0.1
GSID_PORT=8000

# Path to the SQLite database file (created automatically if missing).
GSID_DB_PATH=gsid.sqlite3

# Environment: development | production
GSID_ENV=development

# ---- Data mode -----------------------------------------------------------
# demo  -> serve only clearly-labelled demo fixtures (default, no network).
# live  -> enable RSS ingestion from configured, legally-accessible feeds.
# hybrid-> serve demo fixtures AND live-ingested stories side by side.
GSID_DATA_MODE=demo

# Comma-separated allowlist of feed IDs to enable in live/hybrid mode.
# See gsid/ingestion/connectors.py for the built-in registry of feed IDs.
# Leave blank to enable ALL feeds marked enabled_by_default.
GSID_ENABLED_FEEDS=

# Minimum minutes between ingestion runs (rate limiting for outbound fetches).
GSID_INGEST_INTERVAL_MINUTES=30

# In-process auto-refresh: run ingestion automatically every N hours while the
# server is running. 0 = disabled (default). Set to 24 for a daily refresh, or
# e.g. 6 for four times a day. Only active in live/hybrid mode.
GSID_INGEST_EVERY_HOURS=0

# Per-feed request timeout (seconds).
GSID_FETCH_TIMEOUT_SECONDS=15

# ---- AI analysis provider ------------------------------------------------
# Provider used to enrich stories with structured analysis.
#   heuristic -> deterministic, no external calls, no key required (default).
#   anthropic -> uses Anthropic Claude models (requires ANTHROPIC_API_KEY).
#   openai    -> uses OpenAI models (requires OPENAI_API_KEY).
GSID_AI_PROVIDER=heuristic

# Anthropic (only used when GSID_AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
GSID_ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (only used when GSID_AI_PROVIDER=openai)
OPENAI_API_KEY=
GSID_OPENAI_MODEL=gpt-4o-mini

# ---- Authentication ------------------------------------------------------
# When enabled, watchlist/settings changes require the shared access token.
# Single-user deployment: set a token and pass it via the X-GSID-Token header
# or the login screen. For multi-user, replace with a real identity provider.
GSID_AUTH_ENABLED=false
GSID_ACCESS_TOKEN=

# ---- Public read-only deployment -----------------------------------------
# When true, ANY visitor can browse and (optionally) refresh, but changing
# settings/watchlists/feeds requires the admin token. Per-visitor items
# (saved stories, quiz progress) live in each browser, so no login is needed
# just to use the desk. Ideal for hosting the desk for a whole team.
GSID_PUBLIC_READONLY=false
# Token that unlocks editing in read-only mode (set a long random value).
GSID_ADMIN_TOKEN=
# Allow anonymous visitors to trigger a data refresh (rate-limited). Admins
# can always refresh regardless of this setting.
GSID_PUBLIC_ALLOW_REFRESH=true

# ---- User default preferences (seed values) ------------------------------
GSID_DEFAULT_TIMEZONE=UTC
